# ============================================
# Python & Jupyter Notebook .gitignore
# ============================================

# Byte-compiled / optimized / DLL files
__pycache__/*.py[cod]
*$py.class

# Virtual environments
venv/
env/
ENV/
.venv/
.env/

# Jupyter Notebook checkpoints (auto-generated)
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# IPython
ipython_config.py

# Python profiler output
.python_profiler_output

# Jupyter Notebook (optional - usually you want to commit .ipynb files)
# Uncomment if you DON'T want to commit notebooks:
# *.ipynb

# Test and coverage results
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nox-session/
.pytest_cache/
.mypy_cache/

# VS Code
.vscode/

# PyCharm
.idea/

# macOS
.DS_Store

# Sensitive files (environment variables, API keys)
.env
.env.local
*.secret
secret.json

# Pareto log files
*.log

# Database files (if local)
*.sqlite
*.sqlite3

# Pip
pip-log.txt
pip-delete-this-directory.txt
